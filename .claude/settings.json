{
  "permissions": {
    "ask": [
      "mcp__tietrace-alpha__record_verdict",
      "mcp__tietrace-alpha__approve_note",
      "mcp__tietrace-beta__record_verdict",
      "mcp__tietrace-beta__approve_note",
      "Bash(uv run python loader.py *)",
      "Bash(python loader.py *)",
      "Bash(python3 loader.py *)",
      "Bash(*loader.py *)"
    ],
    "deny": [
      "Read(/.env)",
      "Edit(/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_loader.py"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
