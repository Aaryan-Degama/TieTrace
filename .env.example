# Copy to .env and fill in the key. Never commit .env.
# loader.py reads only OPENALEX_API_KEY from this file.
OPENALEX_API_KEY=

# Optional, with their defaults. The code reads these from the process environment
# (export them, or pass -e to `claude mcp add`); they are listed here for reference.
# FALKORDB_PORT=6379
# TIETRACE_NEWSROOM=alpha     (required by server.py; no default)
# TIETRACE_CASE=obesity-coke
